{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "it.unibo.sage.Main",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/*"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Run S.A.G.E.",
            "request": "launch",
            "mainClass": "it.unibo.sage.Main",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/*"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Run Tests",
            "request": "launch",
            "mainClass": "it.unibo.sage.test.TestSuite",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/*"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Run DB Tests",
            "request": "launch",
            "mainClass": "it.unibo.sage.test.TestSuite",
            "vmArgs": "-Dsage.db.tests=true",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/*"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
